"use client";
import { useState } from "react";
import { initializeApp, getApps } from "firebase/app";
import { getFirestore, collection, addDoc, serverTimestamp } from "firebase/firestore";

const firebaseConfig = {
  apiKey: "AIzaSyCulND3XoR7XhJIdZe6SRI8_-D3Ikj7w0w",
  authDomain: "studio-shivam.firebaseapp.com",
  projectId: "studio-shivam",
  storageBucket: "studio-shivam.firebasestorage.app",
  messagingSenderId: "9621435697",
  appId: "1:9621435697:web:e690304ef64667f0b7ac10"
};

const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApps()[0];
const db = getFirestore(app);

export default function Admin() {
  const [formData, setFormData] = useState({ title: '', imageUrl: '', videoUrl: '', downloadUrl: '', version: '', size: '' });

  const handleUpload = async (e) => {
    e.preventDefault();
    try {
      await addDoc(collection(db, "posts"), { ...formData, createdAt: serverTimestamp() });
      alert("APK Uploaded Successfully!");
      setFormData({ title: '', imageUrl: '', videoUrl: '', downloadUrl: '', version: '', size: '' });
    } catch (err) { alert("Error: " + err.message); }
  };

  return (
    <div style={{ backgroundColor: '#0a0b14', minHeight: '100vh', color: 'white', padding: '20px', fontFamily: 'sans-serif' }}>
      <h1 style={{ textAlign: 'center' }}>Studio Manager</h1>
      <form onSubmit={handleUpload} style={{ maxWidth: '400px', margin: '0 auto', display: 'flex', flexDirection: 'column', gap: '15px' }}>
        <input placeholder="App Name" style={inputStyle} value={formData.title} onChange={e => setFormData({...formData, title: e.target.value})} required />
        <input placeholder="Photo URL (Link)" style={inputStyle} value={formData.imageUrl} onChange={e => setFormData({...formData, imageUrl: e.target.value})} />
        <input placeholder="Video URL (Optional Link)" style={inputStyle} value={formData.videoUrl} onChange={e => setFormData({...formData, videoUrl: e.target.value})} />
        <input placeholder="APK Download Link" style={inputStyle} value={formData.downloadUrl} onChange={e => setFormData({...formData, downloadUrl: e.target.value})} required />
        <div style={{ display: 'flex', gap: '10px' }}>
          <input placeholder="Version (e.g. v2.0)" style={inputStyle} value={formData.version} onChange={e => setFormData({...formData, version: e.target.value})} />
          <input placeholder="Size (e.g. 45MB)" style={inputStyle} value={formData.size} onChange={e => setFormData({...formData, size: e.target.value})} />
        </div>
        <button type="submit" style={{ padding: '15px', background: '#3b82f6', color: 'white', border: 'none', borderRadius: '10px', fontWeight: 'bold', cursor: 'pointer' }}>UPLOAD APK</button>
      </form>
      <center><a href="/" style={{ color: '#94a3b8', marginTop: '20px', display: 'block' }}>Back to Website</a></center>
    </div>
  );
}

const inputStyle = { padding: '12px', borderRadius: '8px', border: '1px solid #232438', backgroundColor: '#161726', color: 'white' };
